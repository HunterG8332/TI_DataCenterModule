# Applied when the sdkconfig is regenerated (e.g. after `idf.py set-target esp32s3`).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BMC_TEST_HOOKS=y
CONFIG_BMC_NET_SSID="BMC-Telemetry"
CONFIG_BMC_NET_PASSWORD="bmctelemetry"
CONFIG_BMC_NET_CHANNEL=1
CONFIG_BMC_NET_MAX_STATIONS=4
CONFIG_BMC_STREAM_PORT=9000
CONFIG_BMC_STREAM_ID="bmc0"
CONFIG_FREERTOS_HZ=100
